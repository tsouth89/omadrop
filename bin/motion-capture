#!/bin/bash
# Capture a burst of frames from a running Omadrop and assemble a filmstrip.
#
# Stills cannot show smoothness, drift or stutter -- every motion complaint
# this project has had is invisible in a single frame. This grabs a rapid
# sequence from a small region (grim is much faster on a crop), lays them out
# as a contact sheet, and prints the frame-to-frame difference series so
# stutter shows up as spikes in an otherwise flat line.
#
# Usage: motion-capture [frames] [region]
# env: OMADROP_* pass through, MOTION_MAX_JITTER optionally fails unstable captures
set -uo pipefail
HERE=$(dirname "$(readlink -f "$0")")
FRAMES=${1:-24}
REGION=${2:-}
OUT=${MOTION_OUT:-/tmp/omadrop-motion}
mkdir -p "$OUT"
rm -f "$OUT"/f*.png "$OUT"/strip.png

if [[ -n ${OMADROP_PRESET_PATH:-} ]]; then
  OMADROP_FULLSCREEN=0 OMADROP_DISABLE_ART=1 \
    "$HERE/../experiments/projectm-ascii/projectm-ascii-live" \
    "$OMADROP_PRESET_PATH" >/dev/null 2>&1 &
else
  OMADROP_MONITORS=single OMADROP_FULLSCREEN=0 OMADROP_DISABLE_ART=1 \
    "$HERE/omadrop" --single >/dev/null 2>&1 &
fi
APP=$!
trap 'kill $APP 2>/dev/null' EXIT

client=
for _ in $(seq 1 80); do
  client=$(hyprctl clients -j 2>/dev/null | jq -c --argjson pid "$APP" \
    '.[] | select(.pid == $pid)' | head -n 1)
  [[ -n $client ]] && break
  sleep 0.1
done
if [[ -z $client ]]; then
  echo "motion-capture: Omadrop window did not appear" >&2
  exit 1
fi
if [[ -z $REGION ]]; then
  x=$(jq -r '.at[0]' <<<"$client")
  y=$(jq -r '.at[1]' <<<"$client")
  w=$(jq -r '.size[0]' <<<"$client")
  h=$(jq -r '.size[1]' <<<"$client")
  REGION="$x,$y ${w}x${h}"
fi
sleep "${SETTLE:-3}"

start=$(date +%s.%N)
for i in $(seq -w 1 "$FRAMES"); do
  grim -g "$REGION" "$OUT/f$i.png"
done
end=$(date +%s.%N)

kill $APP 2>/dev/null; trap - EXIT
fps=$(awk -v s="$start" -v e="$end" -v n="$FRAMES" 'BEGIN{printf "%.1f", n/(e-s)}')
echo "captured $FRAMES frames at ~${fps} fps into $OUT"

magick montage "$OUT"/f*.png -tile 6x -geometry 260x146+2+2 -background '#111' "$OUT/strip.png"
echo "filmstrip: $OUT/strip.png"

# Difference series: smooth motion gives a flat line, stutter gives spikes.
python3 - "$OUT" "$fps" <<'PY'
import subprocess, sys, glob, os
d, fps = sys.argv[1], sys.argv[2]
fs = sorted(glob.glob(os.path.join(d, "f*.png")))
vals = []
for a, b in zip(fs, fs[1:]):
    out = subprocess.run(["magick","compare","-metric","RMSE",a,b,"null:"],
                         capture_output=True, text=True).stderr
    try: vals.append(float(out.split("(")[1].split(")")[0]))
    except Exception: vals.append(0.0)
if not vals: raise SystemExit
mean = sum(vals)/len(vals)
peak = max(vals)
jitter = (peak/mean) if mean else 0
print(f"frame-to-frame change: mean={mean:.4f} peak={peak:.4f} peak/mean={jitter:.2f}")
print("  (peak/mean near 1 = steady motion; >2.5 = lurching)")
print("  " + "".join("#" if v > mean*1.6 else ("+" if v > mean*0.6 else ".") for v in vals))
limit = os.environ.get("MOTION_MAX_JITTER")
if limit and jitter > float(limit):
    print(f"motion-capture: jitter {jitter:.2f} exceeds limit {float(limit):.2f}",
          file=sys.stderr)
    raise SystemExit(1)
PY
