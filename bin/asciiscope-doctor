#!/bin/bash
# Quick environment check for a fresh machine.
echo "== ASCIIscope environment =="
for c in qs grim magick pactl pw-record python3; do
  printf '%-12s %s\n' "$c" "$(command -v $c || echo MISSING)"
done
printf '%-12s %s\n' "qsb" "$( [ -x /usr/lib/qt6/bin/qsb ] && echo /usr/lib/qt6/bin/qsb || echo 'MISSING (pacman -S qt6-shadertools)')"
python3 -c "import numpy; print('numpy       ' + numpy.__version__)" 2>/dev/null || echo "numpy       MISSING"
echo
echo "default sink: $(pactl get-default-sink 2>/dev/null)"
echo "playing now : $(pactl list short sink-inputs 2>/dev/null | wc -l) stream(s)"
echo "shaders     : $( [ -f "$(dirname "$0")/../shaders/braille.frag.qsb" ] && echo baked || echo 'NOT BAKED - run ./build.sh')"
