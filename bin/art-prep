#!/bin/bash
# Prepare album art for the renderer without changing its composition or
# palette. Exposure is handled per braille cell in the shader, where dark and
# bright areas can be treated independently.
set -euo pipefail

IN=${1:?usage: art-prep <in> <out>}
OUT=${2:?usage: art-prep <in> <out>}
SIZE=${SIZE:-2048}

magick "$IN" -auto-orient -colorspace sRGB -filter Lanczos \
  -resize "${SIZE}x${SIZE}" -background black -gravity center \
  -extent "${SIZE}x${SIZE}" -alpha remove -alpha off -strip "$OUT"
